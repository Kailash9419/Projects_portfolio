---
import Icon from '../../components/Icon.astro';
import type { Locale } from '../../content/types';
import { contact, site } from '../../content/site';
import { t } from '../../lib/i18n';
import { mailtoLink, whatsappLink } from '../../lib/whatsapp';

interface Props { locale: Locale }
const { locale } = Astro.props;
const c = site.contact;
const defaultMsg = `${t(c.messageIntro, locale)} ${t(c.messageDefault, locale)}`;
const subject = 'DevLabs — project enquiry';
// Strings the browser script needs, serialised once.
const strings = JSON.stringify({
  intro: t(c.messageIntro, locale),
  nameTemplate: t(c.messageName, locale),
  needTemplate: t(c.messageNeed, locale),
  fallback: t(c.messageDefault, locale),
  phone: contact.phoneE164,
  email: contact.email,
  subject,
  locale,
});
---
<section id="contact" class="contact section" aria-labelledby="contact-title">
  <div class="wrap">
  <div class="grid contact__grid">
    <header class="contact__intro" data-reveal>
      <p class="label">{t(c.eyebrow, locale)}</p>
      <h2 id="contact-title" class="display contact__title">{t(c.title, locale)}</h2>
      <p class="lede">{t(c.lede, locale)}</p>
      <ul class="contact__direct" role="list">
        <li><a href={`tel:+${contact.phoneE164}`}>{contact.phoneDisplay}</a></li>
        <li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
      </ul>
    </header>

    <div class="composer" data-composer data-strings={strings} data-reveal>
      <fieldset class="composer__needs">
        <legend class="composer__legend">{t(c.needLegend, locale)}</legend>
        <div class="composer__chips">
          {c.needs.map((n) => (
            <label class="chip">
              <input type="checkbox" name="need" value={t(n.label, locale)} />
              <span>{t(n.label, locale)}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <label class="composer__field">
        <span>{t(c.nameLabel, locale)}</span>
        <input type="text" name="name" autocomplete="name" maxlength="60" />
      </label>

      <p class="composer__preview" data-preview>{defaultMsg}</p>

      <div class="composer__actions">
        <a class="btn btn--primary" data-wa href={whatsappLink(contact.phoneE164, defaultMsg)} target="_blank" rel="noopener">
          <Icon name="whatsapp" />{t(c.whatsapp, locale)}
        </a>
        <a class="btn" data-mail href={mailtoLink(contact.email, subject, defaultMsg)}>
          <Icon name="mail" />{t(c.email, locale)}
        </a>
      </div>
      <p class="composer__privacy">{t(c.privacy, locale)}</p>
    </div>
  </div>
  </div>
</section>

<script>
  import { initComposer } from './composer';
  const el = document.querySelector<HTMLElement>('[data-composer]');
  if (el) initComposer(el);
</script>

<style>
  .contact {
    padding-top: calc(var(--section) * 0.6);
  }
  .contact__grid {
    row-gap: 3rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    align-items: start;
  }
  .contact__intro {
    grid-column: 1 / span 6;
    display: grid;
    gap: 1.5rem;
    align-content: start;
  }
  .contact__title {
    margin-top: 1rem;
  }
  .contact__direct {
    display: grid;
    gap: 0.25rem;
    font-size: var(--fs-lede);
    margin-top: 0.5rem;
  }
  .contact__direct a {
    text-decoration: none;
    border-bottom: 1px solid var(--line-strong);
    transition: border-color var(--dur-fast) var(--ease);
  }
  .contact__direct a:hover { border-color: var(--accent); }
  .composer {
    grid-column: 8 / -1;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) * 1.5);
    padding: clamp(1.25rem, 3vw, 2rem);
    display: grid;
    gap: 1.5rem;
  }
  .composer__needs {
    border: 0;
    padding: 0;
    margin: 0;
  }
  .composer__legend {
    font-weight: 500;
    margin-bottom: 0.85rem;
    padding: 0;
  }
  .composer__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .chip {
    position: relative;
    cursor: pointer;
  }
  .chip input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }
  .chip span {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0.4rem 0.95rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: 0.9rem;
    transition: background-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
  }
  .chip:hover span { border-color: var(--text); }
  .chip input:checked + span {
    background: var(--text);
    border-color: var(--text);
    color: var(--bg);
  }
  .chip input:focus-visible + span {
    box-shadow: var(--focus);
  }
  .composer__field {
    display: grid;
    gap: 0.5rem;
    font-weight: 500;
  }
  .composer__field input {
    min-height: 3rem;
    padding: 0.7rem 1rem;
    border-radius: 10px;
    border: 1px solid var(--line-strong);
    background: var(--bg);
    font-weight: 400;
  }
  .composer__field input:focus-visible {
    border-color: var(--accent);
  }
  .composer__preview {
    padding: 0.9rem 1rem;
    border-radius: 14px 14px 14px 4px;
    background: var(--surface-2);
    border: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.95rem;
  }
  .composer__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .composer__privacy {
    color: var(--faint);
    font-size: var(--fs-small);
  }
  @media (max-width: 900px) {
    .contact__intro, .composer { grid-column: 1 / -1; }
  }
</style>
