---
// Small inline icon set (original paths). Decorative: always aria-hidden.
interface Props { name: 'whatsapp' | 'arrow' | 'arrow-left' | 'mail' | 'external' | 'pause' | 'play' }
const { name } = Astro.props;
---
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
  {name === 'whatsapp' && (
    <>
      <path d="M4 20l1.3-3.9A8.5 8.5 0 1 1 8 19z" />
      <path d="M9 8.8c0 3 2.6 6 6 6.4l1.4-1.4-2-1-1 .8a4.6 4.6 0 0 1-2.4-2.4l.8-1-1-2-1.5 1.3" fill="currentColor" stroke="none" />
    </>
  )}
  {name === 'arrow' && <path d="M5 12h14M13 6l6 6-6 6" />}
  {name === 'arrow-left' && <path d="M19 12H5M11 6l-6 6 6 6" />}
  {name === 'mail' && (<><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3.5 6.5 12 13l8.5-6.5" /></>)}
  {name === 'pause' && <path d="M9 6v12M15 6v12" />}
  {name === 'play' && <path d="M8 5.5v13l10-6.5z" fill="currentColor" />}
  {name === 'external' && <path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" />}
</svg>
