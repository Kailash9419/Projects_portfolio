# Copy to .env.local for local development. On Vercel, set these under
# Project → Settings → Environment Variables.

# --- Admin panel (/admin) ---
# Login password. Admin login is disabled when unset.
ADMIN_PASSWORD=
# 32+ random characters used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# --- Storage (production) ---
# Added automatically when you connect a Vercel Blob store to the project.
# Without it, local dev reads/writes src/data/projects.json and public/uploads.
BLOB_READ_WRITE_TOKEN=

# --- Contact form ---
# API key from https://resend.com. Without it, the form shows a WhatsApp fallback.
RESEND_API_KEY=
# Inbox that receives inquiries (defaults to the studio email in src/data/brand.ts).
CONTACT_TO_EMAIL=
# Verified sender on your Resend domain, e.g. "DevLabs <hello@devlabs.studio>".
# Defaults to Resend's test sender, which can only deliver to your own Resend account email.
CONTACT_FROM_EMAIL=

# --- Site ---
# Public URL used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://devlabs.studio
